# Lattice ECP5 Pin Constraints for Guitar Amp
# Target: ULX3S (ECP5-85F-6BG381)
# Adjust pin numbers for your specific board

# Clock
LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25.0 MHz;

# Reset (active low)
LOCATE COMP "rst_n" SITE "D6";
IOBUF PORT "rst_n" PULLMODE=UP IO_TYPE=LVCMOS33;

# I2S ADC (input)
LOCATE COMP "i2s_adc_bclk" SITE "B11";
LOCATE COMP "i2s_adc_lrclk" SITE "A10";
LOCATE COMP "i2s_adc_sdata" SITE "A11";
IOBUF PORT "i2s_adc_bclk" IO_TYPE=LVCMOS33;
IOBUF PORT "i2s_adc_lrclk" IO_TYPE=LVCMOS33;
IOBUF PORT "i2s_adc_sdata" IO_TYPE=LVCMOS33;

# I2S DAC (output)
LOCATE COMP "i2s_dac_mclk" SITE "C11";
LOCATE COMP "i2s_dac_bclk" SITE "A9";
LOCATE COMP "i2s_dac_lrclk" SITE "B10";
LOCATE COMP "i2s_dac_sdata" SITE "A8";
IOBUF PORT "i2s_dac_mclk" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "i2s_dac_bclk" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "i2s_dac_lrclk" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "i2s_dac_sdata" IO_TYPE=LVCMOS33 DRIVE=8;

# SPI (control interface)
LOCATE COMP "spi_clk" SITE "C6";
LOCATE COMP "spi_mosi" SITE "B6";
LOCATE COMP "spi_miso" SITE "A6";
LOCATE COMP "spi_cs_n" SITE "C7";
IOBUF PORT "spi_clk" IO_TYPE=LVCMOS33;
IOBUF PORT "spi_mosi" IO_TYPE=LVCMOS33;
IOBUF PORT "spi_miso" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULLMODE=UP;

# UART
LOCATE COMP "uart_rx" SITE "M1";
LOCATE COMP "uart_tx" SITE "L4";
IOBUF PORT "uart_rx" IO_TYPE=LVCMOS33;
IOBUF PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;

# Buttons / Footswitches
LOCATE COMP "btn[0]" SITE "D6";
LOCATE COMP "btn[1]" SITE "R1";
LOCATE COMP "btn[2]" SITE "T1";
LOCATE COMP "btn[3]" SITE "R18";
IOBUF PORT "btn[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;
IOBUF PORT "btn[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
IOBUF PORT "btn[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
IOBUF PORT "btn[3]" IO_TYPE=LVCMOS33 PULLMODE=UP;

# LEDs
LOCATE COMP "led[0]" SITE "B2";
LOCATE COMP "led[1]" SITE "C2";
LOCATE COMP "led[2]" SITE "C1";
LOCATE COMP "led[3]" SITE "D2";
IOBUF PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;

# Timing constraints
BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
